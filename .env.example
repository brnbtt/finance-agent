# Copy to .env and fill in. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated codes that let new users finish onboarding
INVITE_CODES=

# Azure AI Foundry resource endpoint, e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# Optional. Leave empty to use Entra ID (az login locally, managed identity in Azure).
AZURE_OPENAI_API_KEY=

DATABASE_PATH=data/finance_bot.db
